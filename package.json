{
  "name": "moekoe",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "description": "MoeKoe mobile app",
  "scripts": {
    "start": "expo start",
    "generate:mobile-api": "node ./scripts/generate-mobile-api-entry.mjs",
    "release:version": "node ./scripts/update-version.mjs",
    "release:ota": "npx eas-cli update --channel production",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:android:dev": "npx eas-cli build --profile development --platform android",
    "build:ios:dev": "npx eas-cli build --profile development --platform ios"
  },
  "private": true,
  "license": "GPL-2.0-only",
  "dependencies": {
    "@expo/ui": "~55.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@tamagui/config": "^2.4.6",
    "buffer": "^6.0.3",
    "expo": "~55.0.0",
    "expo-asset": "~55.0.0",
    "expo-audio": "~55.0.0",
    "expo-build-properties": "~55.0.0",
    "expo-constants": "~55.0.0",
    "expo-dev-client": "~55.0.0",
    "expo-device": "~55.0.0",
    "expo-file-system": "~55.0.0",
    "expo-font": "~55.0.0",
    "expo-image": "~55.0.0",
    "expo-linear-gradient": "~55.0.0",
    "expo-linking": "~55.0.0",
    "expo-router": "~55.0.0",
    "expo-secure-store": "~55.0.0",
    "expo-splash-screen": "~55.0.0",
    "expo-status-bar": "~55.0.0",
    "expo-symbols": "~55.0.0",
    "expo-system-ui": "~55.0.0",
    "expo-updates": "~55.0.0",
    "expo-video": "~55.0.0",
    "expo-web-browser": "~55.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "tamagui": "^2.4.6"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "typescript": "~5.9.2"
  }
}
